rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(authorId) {
      return isSignedIn() && request.auth.uid == authorId;
    }

    function isValidItem(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.type in ['lost', 'found'] &&
             data.category is string &&
             data.location is string && data.location.size() <= 500 &&
             data.authorId == request.auth.uid &&
             data.status in ['active', 'resolved'];
    }

    match /items/{itemId} {
      allow read: if true; // Public listings are readable by everyone
      allow create: if isSignedIn() && isValidItem(request.resource.data);
      allow update: if isOwner(resource.data.authorId) && isValidItem(request.resource.data);
      allow delete: if isOwner(resource.data.authorId);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
